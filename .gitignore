# The autosave-watch must NOT snapshot constant log churn into git.
dev.log
.zscripts/*.log
.zscripts/*.pid
.next/dev/
.zscripts/autosave.pid

# Python build artifacts — never track
__pycache__/
*.pyc
*.pyo

# Log files — never track (build/runtime output)
*.log
