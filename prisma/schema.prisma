// Latent.pk — Prisma schema
// SQLite for MVP; swap to Postgres for production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  riskProfile  RiskProfile?
  plans        Plan[]
  trades       Trade[]
}

model RiskProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 1-10 score from onboarding questionnaire
  riskTolerance     Int
  // years
  timeHorizon       Int
  // PKR per month
  monthlyContribution Int
  // e.g. "House down payment", "Kid's education", "Retirement"
  goalLabel         String
  goalTargetAmount  Int    // PKR
  goalDate          DateTime
  // computed at onboarding: conservative | moderate | growth | aggressive
  profileBucket     String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Plan {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // JSON string: array of { symbol, name, allocationPct, horizon, thesis }
  allocation      String
  // JSON string: array of { month, amount, instructions }
  entryLadder     String
  rebalancingRules String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Trade {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  signalId      String
  symbol        String
  direction     String    // LONG | SHORT
  horizon       String    // DAY | SWING | DIVIDEND | GROWTH
  entryPrice    Float
  exitPrice     Float?
  entryDate     DateTime  @default(now())
  exitDate      DateTime?
  status        String    // OPEN | CLOSED_WIN | CLOSED_LOSS | CLOSED_BREAKEVEN
  pnlPct        Float?
  pnlPkr        Float?
  // for accuracy report
  timeToCloseDays Int?
}

// One-time backup of daily OHLCV history for all PSX symbols (backfill from
// the psxdata API at https://psxdata-api.fastapicloud.dev). Used by the
// backtest/simulation engine to run trade-by-trade on ALL stocks locally
// (fast, no per-stock live fetch). Live/ticker data is still fetched from the
// API at request time — this table is a backup + the backtest's local corpus.
model OhlcvBar {
  symbol    String   // PSX ticker, e.g. "LUCK"
  date      String   // YYYY-MM-DD (SQLite-friendly, tz-stable)
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float    @default(0)
  source    String   @default("psxdata") // "psxdata" | "pypsx"
  updatedAt DateTime @default(now())

  @@id([symbol, date])
  @@index([symbol])
  @@index([date])
}

// Cached output of the Price Pattern Finder engine (+ optional LLM layer).
// One row per symbol; PERMANENT cache — rows are never deleted or expired by
// the server. Recomputed only via ?refresh=1 (explicit user action) or the
// nightly precompute script (which UPSERTS — never deletes).
model PricePatternCache {
  symbol         String   @id
  // JSON: full PricePatternAnalysis (patterns + seasonality + zones + gaps ...)
  patternsJson   String
  // JSON: LLM layer { overallSummary, notableObservations, patternExplanations } or null
  summaryJson    String
  computedAt     DateTime @default(now())
  dataSourceDate String? // last bar date the analysis was computed on
}

// Cached RESULT (quarterly financial results) patterns per stock — the
// "Result Pattern" tab of the Pattern Finder. PERMANENT cache (never deleted
// by the server); recomputed only via ?refresh=1 or the precompute script.
model ResultPatternCache {
  symbol         String   @id
  // JSON: quarterly results array (same shape as /api/psx/financial-results)
  resultsJson    String
  // JSON: detected patterns (detectPatterns() output array)
  patternsJson   String
  // JSON: LLM layman summary { laymanSummary, patternExplanations, watchNext } or null
  summaryJson    String
  computedAt     DateTime @default(now())
  dataSourceDate String? // date of the most recent quarterly period in the payload
}

// Extended-training cache: per-model + per-ensemble PREDICTIONS for stocks that
// are outside the original ML-trained universe (new / low-data PSX listings).
// One row per symbol; predictionsJson holds { models: {...}, ensembles: {...} }.
// PERMANENT cache so repeat visits never recompute.
model ModelPredictionCache {
  symbol         String   @id
  // JSON: { models: Record<modelName, prediction>, ensembles: Record<ensKey, prediction> }
  predictionsJson String
  computedAt     DateTime @default(now())
  dataSourceDate String? // last bar date the predictions were computed on
}

// Backtest stats per model / ensemble computed over the FULL extended universe
// (original 674 trained stocks + fallback-covered stocks). Keyed exactly like
// the Backtesting Report expects: models use their display name (e.g.
// "PatchTST", "XGBoost (CL)"), ensembles use snake_case keys (e.g.
// "cl2_ensemble"). PERMANENT cache.
model ModelBacktestCache {
  key            String   @id
  kind           String   // "model" | "ensemble"
  label          String   // human-readable display label
  payloadJson    String   // JSON: full backtest stats (totalTrades, winRate, ...)
  coveredSymbols Int      @default(0) // how many symbols the backtest covered
  computedAt     DateTime @default(now())
}

// Prospective, IMMUTABLE prediction record (Priority 7) — stores a prediction
// BEFORE its outcome is known; outcomes are filled later only after maturity.
// dedupKey = "SYMBOL|modelId|modelVersion|predictionTs" guarantees repeated
// API requests never create duplicate prediction events. Records are never
// overwritten with new forecasts (dedup hit only refreshes non-essential
// fields) so future honesty audits can replay exactly what was claimed.
model PredictionHistory {
  id             String   @id @default(cuid())
  dedupKey       String   @unique
  symbol         String
  modelId        String
  modelVersion   String
  predictionTs   String // epoch ms as string (SQLite-friendly, stable sort)
  signal         String // BUY | SELL | HOLD
  predictedReturn Float?
  predictedProb  Float?
  confidenceType String   @default("heuristic") // heuristic | calibrated
  entryPrice     Float?
  horizon        Int?
  dataCutoff     String? // ISO date of the data the forecast was made on
  kind           String   @default("prospective") // prospective | simulated | out-of-sample | technical-rule
  outcomeStatus  String   @default("pending") // pending | matured | unavailable
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([symbol])
  @@index([modelId])
  @@index([outcomeStatus])
}

// Task 76 — Forecast-outcome maturity (SEPARATE from trade outcomes).
// Immutable: once a verified outcome is recorded (target close observed), it is
// never overwritten. Repeated workflow runs find the existing outcome and skip.
// One-to-one with PredictionHistory via predictionId (unique). The forecast
// outcome (prediction quality) is independent of whether a paper trade closed.
model PredictionOutcome {
  id              String   @id @default(cuid())
  predictionId    String   @unique // → PredictionHistory.id (1:1)
  targetDate      String?  // YYYY-MM-DD of the target trading session
  observedClose   Float?   // actual OHLCV close at the target session
  actualReturn    Float?   // (observedClose − decisionRef) / decisionRef
  maturityTs      String?  // epoch ms when the outcome was recorded
  outcomeStatus   String   @default("pending") // pending | matured | unavailable
  retryCount      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([outcomeStatus])
  @@index([targetDate])
}

// Task 76 — Prospective paper-trade ledger. Each trade traces back to ONE
// PredictionHistory record + a strategy policy. Uniqueness: one entry per
// (sourcePredictionId, strategyId, bookId) — the same prediction cannot create
// duplicate entries for the same strategy/book. The three strategies CAN each
// have their own trade for the same prediction (paired comparison). Seed/demo
// rows are explicitly marked (isDemo) and excluded from genuine metrics.
model ProspectivePaperTrade {
  id                   String   @id @default(cuid())
  sourcePredictionId   String   // → PredictionHistory.id
  strategyId           String   // fixed_first_hit | max_tp_step_trailing | scale_out_50_25_25
  policyVersion        String   // task76-v1 (bump if exit rules change)
  bookId               String   // shadow portfolio identity (e.g. "book_standard_psx_5d")
  modelId              String
  horizon              Int?
  symbol               String
  direction            String   // BUY | SELL
  state                String   @default("pending_entry") // pending_entry | open | closed | skipped
  entryDate            String?  // actual entry session date
  entryPrice           Float?   // observed next-session open
  quantity             Int?     // integer shares
  allocatedCash        Float?
  sl                   Float?
  tp1                  Float?
  tp2                  Float?
  tp3                  Float?
  activeStopFinal      Float?   // for trailing strategy (last stepped stop)
  exitReason           String?  // SL | TP3 | TRAILING_SL | SCALE_TP1_TP2_TP3 | TIME_UP | skipped:reason
  grossPnl             Float?   @default(0)
  totalCosts           Float?   @default(0)
  netPnl               Float?   @default(0)
  isWin                Boolean?
  isDemo               Boolean  @default(false) // seed/demo rows explicitly marked + excluded from real metrics
  skipReason           String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  legs                 PaperTradeLeg[]

  @@unique([sourcePredictionId, strategyId, bookId])
  @@index([strategyId, bookId])
  @@index([symbol])
  @@index([state])
}

// Task 76 — Exit legs for scale-out trades (and any multi-leg strategy).
// One leg per actual exit event (quantity, fill, costs, P&L). For single-exit
// strategies (fixed/trailing), one leg. For scale-out, 1-3 legs. Idempotent:
// unique on (tradeId, legIdx) — no duplicate legs on rerun.
model PaperTradeLeg {
  id              String   @id @default(cuid())
  tradeId         String   // → ProspectivePaperTrade.id
  trade           ProspectivePaperTrade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  legIdx          Int      // 0-based leg order within the trade
  exitDate        String?
  exitPrice       Float?
  exitReason      String?
  quantity        Int?
  grossPnl        Float?   @default(0)
  commission      Float?   @default(0)
  slippage        Float?   @default(0)
  cgt             Float?   @default(0)
  totalCost       Float?   @default(0)
  netPnl          Float?   @default(0)
  createdAt       DateTime @default(now())

  @@unique([tradeId, legIdx])
  @@index([tradeId])
}

// Task 77 — Immutable risk-level overlay for prospective predictions.
// PredictionHistory stores the forecast (signal/return) but NOT SL/TP levels
// (adding them would violate original-forecast immutability). This linked 1:1
// record stores point-in-time risk-management levels computed solely from
// OHLCV available at or before the prediction's dataCutoff, using the canonical
// ATR(14)-based formula from investment-simulator.ts (slDist=ATR×1.5,
// tp1Dist=ATR×1, tp2Dist=ATR×2, tp3Dist=ATR×3). Levels are relative to the
// entryReference (cutoff close) — the decision reference known at cutoff. The
// trade enters at the next-session open and uses these PRESET levels (not
// recomputed at entry) so the plan decided at cutoff is honoured exactly.
// Immutable: once created, never overwritten. Repeated runs find the existing
// record (unique on predictionId) and skip.
model PredictionRiskLevels {
  id                String   @id @default(cuid())
  predictionId      String   @unique // → PredictionHistory.id (1:1 immutable)
  riskPolicyId      String   // "atr14-1.5-1-2-3"
  riskPolicyVersion String   // "task77-v1"
  effectiveCutoff   String   // dataCutoff the levels were computed on (must match prediction)
  entryReference    Float    // close at cutoff (decision reference)
  atr14             Float    // ATR(14) from bars ≤ cutoff
  slDistance        Float    // atr × 1.5
  tp1Distance       Float    // atr × 1.0
  tp2Distance       Float    // atr × 2.0
  tp3Distance       Float    // atr × 3.0
  sl                Float    // planned SL price (entryReference ∓ slDistance)
  tp1               Float    // planned TP1 (entryReference ± tp1Distance)
  tp2               Float    // planned TP2 (entryReference ± tp2Distance)
  tp3               Float    // planned TP3 (entryReference ± tp3Distance)
  direction         String   // BUY | SELL (sign of level offsets)
  barsUsed          Int      // number of bars used for ATR (audit)
  computedAt        DateTime @default(now())
  createdAt         DateTime @default(now())

  @@index([riskPolicyId])
  @@index([effectiveCutoff])
}

// DB-first store for the LEGACY Price Pattern pipeline (price-patterns-service
// + price-pattern-llm behind /api/price-patterns/precompute): reports are
// computed once (statistical engine + one LLM explanation pass), stored here,
// and served from SQLite afterwards so the LLM never runs twice for the same
// data. One row per symbol; UPSERT-only — never deleted or expired by the
// server. NOTE: this is separate from PricePatternCache (the current engine's
// cache used by /api/price-patterns/[symbol]).
model PricePatternReport {
  symbol        String   @id
  computedAt    DateTime @default(now())
  detectionJson String // JSON: { coverage, patterns, zones, seasonality, unusual }
  llmJson       String? // JSON: LlmExplanations { patterns, unusual_notes } or null
  barsCount     Int
  firstDate     String
  lastDate      String
  patternCount  Int
}

// Task 116 — temporary beta onboarding profile (Part G)
// Keyed by an opaque random session token delivered in an HttpOnly cookie —
// no email, no sensitive personal data, no cross-user access (every query
// filters by the exact session token). Deletion is a hard delete (G3 reset).
model BetaProfile {
  id               String   @id @default(cuid())
  // Task 117 Part D: the raw session token lives ONLY in the HttpOnly cookie.
  // Server-side we store sha256(token) — a database leak cannot be replayed.
  sessionTokenHash String   @unique
  consentVersion   String   // e.g. "beta-consent-v1" (pending until accepted)
  consentAcceptedAt DateTime?
  inviteId         String?  // BetaInvite that granted access (null only when BETA_INVITE_REQUIRED=false)
  accessVia        String   @default("invite") // invite | open_flag | operator
  experienceLevel  String?  // new_to_psx | some_experience | experienced
  objective        String?  // learn | growth_research | income_research | swing_research | monitoring
  timeHorizon      String?  // short | medium | long
  lossReaction     String?  // hold | trim | sell | unsure
  capitalNeedSoon  Boolean?
  volatilityComfort String? // low | medium | high
  canTolerateLoss  Boolean?
  preferredSectors String?  // JSON array
  watchlistSymbols String?  // JSON array
  showDividends    Boolean?
  shariahScreen    Boolean?
  atlTaxAssumption Boolean?
  capitalRange     String?  // optional, coarse bucket only
  profileComplete  Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  access ProfileAccess? // Task 121 RBAC plane (server-only)
}

// Task 117 Part C — hashed, revocable, expiring invitations. The raw token is
// shown to the operator exactly once at creation; only sha256 is stored. No
// personal information is collected: no name, email, IP or device fingerprint.
model BetaInvite {
  id              String    @id @default(cuid())
  tokenHash       String    @unique
  label           String?   // operator note (cohort name) — never user data
  status          String    @default("active") // active | revoked
  maxRedemptions  Int       @default(1)
  redemptionCount Int       @default(0)
  createdAt       DateTime  @default(now())
  expiresAt       DateTime?
  redeemedAt      DateTime?
  redeemedProfileIds String @default("[]") // JSON array of BetaProfile ids (audit only, no tokens)
}

// Task 117 Part C2 — runtime-controlled beta configuration (single row, id=1).
// Lets the operator pause registrations or disable the whole beta WITHOUT a
// redeploy. The BETA_ONBOARDING_ENABLED env var, when "false", always wins.
model BetaConfig {
  id                   Int      @id @default(1)
  betaDisabled         Boolean  @default(false)
  registrationsPaused  Boolean  @default(false)
  reason               String?  // operator note shown to users (plain text, no internal detail)
  updatedAt            DateTime @updatedAt
}

// Task 117 Part I4 — beta feedback. No free-form identity fields; the profile
// link is internal (id only, never a token) and exports strip it by default.
model BetaFeedback {
  id         String   @id @default(cuid())
  profileId  String?
  category   String   // confusing_info | incorrect_company_data | stale_prices | broken_interface | missing_feature | general
  message    String
  route      String?  // page path where feedback was submitted
  appVersion String?
  status     String   @default("new") // new | triaged | resolved
  createdAt  DateTime @default(now())
}

// ============================================================================
// Task 121 — admin panel, user panel, role-based access control.
// Additive only: every model below is NEW (no existing table is modified).
// Authorization is deny-by-default and resolved server-side ONLY — the browser
// never sends a role, permission, or plan value that the server trusts.
// ============================================================================

// Admin identity plane — COMPLETELY SEPARATE from BetaProfile users. There is
// no public admin registration, no default password, and no way for a beta
// user to become an admin. The first account is created only by the operator
// CLI (scripts/task121_admin_bootstrap.ts) and only while this table is empty.
// scrypt password format: "scrypt$N$r$p$saltHex$hashHex".
model AdminAccount {
  id               String    @id @default(cuid())
  username         String    @unique
  passwordHash     String    // scrypt$16384$8$1$salt$hash — never exposed via any API
  isActive         Boolean   @default(true)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime? // durable brute-force lockout
  lastLoginAt      DateTime?
  passwordChangedAt DateTime @default(now())
  createdAt        DateTime  @default(now())
  sessions         AdminSession[]
}

// Admin sessions — the raw token exists ONLY in the HttpOnly admin cookie;
// the database stores sha256(token). Short absolute TTL, revocable per admin.
model AdminSession {
  id         String    @id @default(cuid())
  adminId    String
  admin      AdminAccount @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([adminId])
}

// Central permission registry — every managed tab and feature. category is
// "tab" (a UI view / its backing API) or "feature" (a capability such as
// feedback, LLM spend, exports). globalEnabled is the admin master switch:
// when false the permission is denied for every user regardless of plan or
// per-user overrides (admins bypass). defaultEffect is the fallback applied
// when neither the plan nor the user has an explicit row (deny by default).
model PermissionRegistry {
  key              String  @id // "tab.dashboard" | "feature.feedback" | ...
  category         String  // tab | feature
  label            String
  description      String  @default("")
  sortOrder        Int     @default(0)
  globalEnabled    Boolean @default(true)
  // permissions that gate INTERACTION beyond viewing (e.g. running a
  // simulation) are separate registry keys — this column documents the pair
  interactKey       String? // e.g. "feature.research_backtest" for tab.portfolio
  defaultEffect    String  @default("DENY") // ALLOW | DENY
  isCore           Boolean @default(false) // core = identity/profile self-service, never disabled globally
  updatedAt        DateTime @updatedAt
}

// Per-user access assignment — one row per BetaProfile (created lazily on
// first authenticated request or first admin action). status is server-only:
// no user-editable field can change it, and SUSPENDED/DELETED denies every
// user API immediately (no cache to bypass).
model ProfileAccess {
  profileId       String    @id
  profile         BetaProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  planKey         String    @default("BASIC")
  plan            AccessPlan  @relation(fields: [planKey], references: [key])
  status          String    @default("ACTIVE") // ACTIVE | SUSPENDED | DELETED
  statusReason    String?
  accessExpiresAt DateTime? // null = no expiry
  lastSeenAt      DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  permissionOverrides ProfilePermission[]
}

// Per-user permission overrides. effect ALLOW/DENY wins over the plan and the
// registry default (DENY wins over ALLOW at the same scope level).
model ProfilePermission {
  id            String   @id @default(cuid())
  profileId     String
  profile       ProfileAccess @relation(fields: [profileId], references: [profileId], onDelete: Cascade)
  permissionKey String
  effect        String   // ALLOW | DENY
  setByAdminId  String?  // AdminAccount.id (audit trail also records the change)
  updatedAt     DateTime @updatedAt

  @@unique([profileId, permissionKey])
  @@index([permissionKey])
}

// Admin-configurable access plans. limitsJson is a JSON string:
// { maxDailyLlmRequests, maxDailyReportExports, maxDailySimulatorRuns,
//   maxDailyApiRequests, accountExpiryDays } — null/omitted = unlimited.
// No billing integration: plans only shape access and limits.
model AccessPlan {
  key        String  @id // BASIC | STANDARD | PREMIUM (renamable label, stable key)
  label      String
  isEnabled  Boolean @default(true)
  isDefault  Boolean @default(false) // plan assigned to new redemptions
  sortOrder  Int     @default(0)
  limitsJson String  @default("{}")
  updatedAt  DateTime @updatedAt

  planPermissions PlanPermission[]
  profiles        ProfileAccess[]
}

// Plan-level permission defaults applied to every profile on that plan.
model PlanPermission {
  id            String     @id @default(cuid())
  planKey       String
  plan          AccessPlan @relation(fields: [planKey], references: [key], onDelete: Cascade)
  permissionKey String
  effect        String     // ALLOW | DENY
  updatedAt     DateTime   @updatedAt

  @@unique([planKey, permissionKey])
  @@index([permissionKey])
}

// Durable, race-safe daily usage counters. Invariant: increment only happens
// through an atomic conditional UPDATE (count < limit check inside the UPDATE
// WHERE clause), never through read-check-write. SQLite enforces the unique
// key so concurrent requests cannot overshoot a limit.
model UserUsage {
  id        String @id @default(cuid())
  profileId String
  day       String // YYYY-MM-DD (Asia/Karachi)
  kind      String // llm_request | report_export | simulator_run | api_request
  count     Int    @default(0)

  @@unique([profileId, day, kind])
  @@index([profileId, day])
}

// Append-only administrative audit trail. Written on every admin action,
// security event, and permission change. Rows are NEVER updated or deleted by
// any code path and no API exposes a mutation — immutability is enforced by
// construction and verified by tests. Secrets, tokens, cookies and passwords
// must never be placed in before/after payloads.
model AdminAuditLog {
  id            String   @id @default(cuid())
  ts            DateTime @default(now())
  actorType     String   // admin | user | system
  actorId       String   // AdminAccount.id | BetaProfile.id | "system"
  action        String   // e.g. admin.login, user.suspend, permission.set
  targetType    String?  // user | invite | plan | tab | strategy | model | setting | session
  targetId      String?
  beforeJson    String?
  afterJson     String?
  result        String   @default("ok") // ok | denied | error
  failureReason String?
  correlationId String?
  route         String?

  @@index([ts])
  @@index([actorType, actorId])
  @@index([action])
  @@index([targetType, targetId])
}

// Centralized platform settings (single source for maintenance mode, global
// feature pause, default plan, LLM availability, feedback availability).
// Values are validated server-side; security-relevant beta gates stay in
// BetaConfig/env so a setting can never weaken authentication.
model PlatformSetting {
  key         String   @id
  valueJson   String
  description String   @default("")
  updatedBy   String?  // AdminAccount.id
  updatedAt   DateTime @updatedAt
}

// Admin visibility control over the 9 code-registered strategies. Visibility
// changes NEVER touch strategy calculations, validation status, or the
// blocked pairs/Kalman short-leg policy — this table only gates what users see.
model StrategyConfig {
  strategyId          String   @id // engine.ts registry id (e.g. pairs_kalman_hedge)
  userVisible         Boolean  @default(true)
  availabilityEnabled Boolean  @default(true)
  readOnly            Boolean  @default(false)
  updatedBy           String?
  updatedAt           DateTime @updatedAt
}

// Admin visibility control over AI-model inventory entries (ALL_MODELS).
// Display-only: cannot mark a model trained/profitable and cannot promote.
model ModelAccessConfig {
  modelId        String   @id // ensemble.ts ALL_MODELS id
  userVisible    Boolean  @default(true)
  detailsVisible Boolean  @default(true)
  updatedBy      String?
  updatedAt      DateTime @updatedAt
}

// Invitation lifecycle events (creation, revocation, redemptions, pause).
// Complements BetaInvite.redeemedProfileIds with a full append-only trail.
// Retained even if the invite row is later removed (no FK by design).
model InvitationEvent {
  id        String   @id @default(cuid())
  ts        DateTime @default(now())
  inviteId  String
  event     String   // created | revoked | redeemed | rejected | paused | resumed | deleted
  actorType String   // admin | user | system
  actorId   String?
  detailJson String?
}
