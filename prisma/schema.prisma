// Latent.pk — Prisma schema
// SQLite for MVP; swap to Postgres for production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  riskProfile  RiskProfile?
  plans        Plan[]
  trades       Trade[]
}

model RiskProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 1-10 score from onboarding questionnaire
  riskTolerance     Int
  // years
  timeHorizon       Int
  // PKR per month
  monthlyContribution Int
  // e.g. "House down payment", "Kid's education", "Retirement"
  goalLabel         String
  goalTargetAmount  Int    // PKR
  goalDate          DateTime
  // computed at onboarding: conservative | moderate | growth | aggressive
  profileBucket     String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Plan {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // JSON string: array of { symbol, name, allocationPct, horizon, thesis }
  allocation      String
  // JSON string: array of { month, amount, instructions }
  entryLadder     String
  rebalancingRules String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Trade {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  signalId      String
  symbol        String
  direction     String    // LONG | SHORT
  horizon       String    // DAY | SWING | DIVIDEND | GROWTH
  entryPrice    Float
  exitPrice     Float?
  entryDate     DateTime  @default(now())
  exitDate      DateTime?
  status        String    // OPEN | CLOSED_WIN | CLOSED_LOSS | CLOSED_BREAKEVEN
  pnlPct        Float?
  pnlPkr        Float?
  // for accuracy report
  timeToCloseDays Int?
}

// One-time backup of daily OHLCV history for all PSX symbols (backfill from
// the psxdata API at https://psxdata-api.fastapicloud.dev). Used by the
// backtest/simulation engine to run trade-by-trade on ALL stocks locally
// (fast, no per-stock live fetch). Live/ticker data is still fetched from the
// API at request time — this table is a backup + the backtest's local corpus.
model OhlcvBar {
  symbol    String   // PSX ticker, e.g. "LUCK"
  date      String   // YYYY-MM-DD (SQLite-friendly, tz-stable)
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float    @default(0)
  source    String   @default("psxdata") // "psxdata" | "pypsx"
  updatedAt DateTime @default(now())

  @@id([symbol, date])
  @@index([symbol])
  @@index([date])
}
